# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Required ---------------------------------------------------------------

# Anthropic API key. Used for every Claude call (Sonnet / Opus / Haiku).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here


# --- Optional: cross-machine memory sync (Phase 5.4) ------------------------
# Jarvis can push/pull memory.json to a private GitHub Gist so the same
# preferences + history follow you across machines. Leave blank to disable
# (Jarvis works fine without it).
#
# 1. Create a GitHub personal access token with the `gist` scope:
#    https://github.com/settings/tokens
# 2. Create a private Gist with a single file named `memory.json` and copy
#    its ID from the URL (the hex string after your username).

GITHUB_TOKEN=
GIST_ID=
